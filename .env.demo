# .env.demo (committed, contains no secrets)
# Start with: cp .env.demo .env.local

# ---- App (public) ----
VITE_APP_NAME=Pulse Room
VITE_APP_ENV=demo
VITE_DEMO_MODE=true
VITE_DEFAULT_AGENT_NAME=Nova

# ---- Feature flags (public) ----
VITE_FEATURE_LIVEKIT_VOICE=false
VITE_FEATURE_BROWSER_VOICE=true
VITE_FEATURE_WM_BRIEF=true
VITE_FEATURE_NEWS=true

# ---- Firebase web config (public identifiers; protect with rules and authorised domains) ----
VITE_FIREBASE_API_KEY=demo
VITE_FIREBASE_AUTH_DOMAIN=demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-pulse-room
VITE_FIREBASE_APP_ID=demo
VITE_USE_FIREBASE_EMULATOR=true

# ---- LiveKit (public URL only) ----
VITE_LIVEKIT_URL=wss://example.livekit.cloud
VITE_TOKEN_ENDPOINT=/api/token

# ---- Data endpoints (public) ----
VITE_USGS_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/2.5_day.geojson
VITE_EONET_URL=https://eonet.gsfc.nasa.gov/api/v3/events
VITE_WM_PROXY=/api/wm
VITE_LLM_ENDPOINT=/api/llm

# ---- SERVER ONLY (never prefix with VITE_) ----
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
ALLOWED_ORIGINS=http://localhost:5173
ROOM_PREFIX=voice-
TOKEN_TTL_SECONDS=600
VOICE_DAILY_MINUTES_PER_USER=10
LLM_PROVIDER_CHAIN=groq,gemini,cerebras,openrouter,cloudflare
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
CF_ACCOUNT_ID=
CF_API_TOKEN=
WM_API_KEY=
WM_BASE_URL=https://api.worldmonitor.app
RATE_LIMIT_PER_MIN=30
